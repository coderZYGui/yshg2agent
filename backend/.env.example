# ===== 基础 =====
APP_NAME=隐私合规智能评审
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 本地默认 local666；Zeabur 请设置为你自己的强密码。
ACCESS_PASSWORD=local666

# ===== 数据库 =====
# 生产: postgresql+psycopg://user:pass@postgres:5432/compliance
# 留空则本地降级使用 SQLite (backend/data/app.db)
DATABASE_URL=

# ===== 向量库 =====
# pgvector | memory ; 留空自动: 有 Postgres 用 pgvector, 否则 memory
VECTOR_BACKEND=

# ===== DashScope / 百炼应用 =====
# DASHSCOPE_API_KEY 或 DASHSCOPE_APP_ID 留空时会使用 Mock 模式。
LLM_PROVIDER=dashscope_app
DASHSCOPE_API_KEY=
DASHSCOPE_APP_ID=
# 可选：覆盖百炼应用中配置的模型。
DASHSCOPE_MODEL_ID=

# ===== 百炼会话文件 =====
# 上传并解析图片、文档、音频和视频时必填。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION_ID=cn-beijing
BAILIAN_FILE_POLL_INTERVAL_SECONDS=2
BAILIAN_FILE_READY_TIMEOUT_SECONDS=300

# ===== Embedding =====
# 留空则降级为确定性本地向量
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ===== CORS =====
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
