# ===== 基础 =====
APP_NAME=隐私合规智能评审
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 =====
# 生产: postgresql+psycopg://user:pass@postgres:5432/compliance
# 留空则本地降级使用 SQLite (backend/data/app.db)
DATABASE_URL=

# ===== 向量库 =====
# pgvector | memory ; 留空自动: 有 Postgres 用 pgvector, 否则 memory
VECTOR_BACKEND=

# ===== LLM (MiniMax, OpenAI 兼容) =====
# 留空则降级为 Mock, 无需外部服务即可运行
LLM_PROVIDER=minimax
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M1
LLM_VISION_MODEL=MiniMax-VL

# ===== DashScope Bailian App =====
# Set LLM_PROVIDER=dashscope_app to call a Bailian application through the backend.
DASHSCOPE_API_KEY=
DASHSCOPE_APP_ID=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ===== Embedding =====
# 留空则降级为确定性本地向量
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ===== 对象存储 =====
# local | minio ; 默认 local
STORAGE_BACKEND=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=compliance

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
